{
  "name": "analyzator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "typecheck": "tsc -p tsconfig.json && npm --prefix apps/web run typecheck",
    "test": "npm run test:connectors && npm --prefix apps/web run test",
    "test:db": "supabase test db supabase/tests/database",
    "db:reset": "supabase db reset",
    "test:security": "scripts/test-security.sh",
    "probe:clarity": "node --experimental-strip-types --env-file-if-exists=.env.local connectors/clarity/probe.ts",
    "test:connectors": "node --experimental-strip-types --test 'connectors/**/*.test.ts' 'supabase/functions/**/*.test.ts' 'analytics/**/*.test.ts'",
    "collect:clarity": "node --experimental-strip-types --env-file-if-exists=.env.local connectors/clarity/collect.ts",
    "set-source-token": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/set-source-token.ts",
    "test:guards": "scripts/test-guard-mutations.sh",
    "dev:preview": "npm --prefix apps/web run dev:preview",
    "build:staging": "npm --prefix apps/web run build:staging",
    "build:preview": "npm --prefix apps/web run build:preview",
    "test:integration": "scripts/test-integration.sh",
    "collect:seomonitor": "node --experimental-strip-types --env-file-if-exists=.env.local connectors/seomonitor/collect.ts",
    "collect:google": "node --experimental-strip-types --env-file-if-exists=.env.local connectors/google/collect.ts",
    "docs:csv": "node --experimental-strip-types scripts/generate-csv-docs.ts",
    "send:notifications": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/send-notifications.ts",
    "refresh:weekly": "node --experimental-strip-types --env-file-if-exists=.env.local connectors/orchestrator/run.ts",
    "send:ops-notifications": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/send-ops-notifications.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google-analytics/data": "^7.2.1",
    "@googleapis/searchconsole": "^11.0.1",
    "google-auth-library": "^11.2.0",
    "zod": "^4.6.5"
  }
}
